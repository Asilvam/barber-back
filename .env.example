MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/barber
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=https://your-barber-front.herokuapp.com
EMAIL_SERVICE_URL=https://your-email-service.herokuapp.com
EMAIL_SERVICE_API_KEY=generate-a-shared-internal-api-key
EMAIL_SERVICE_TIMEOUT_MS=5000
EMAIL_FROM_NAME=Barber

# Optional: configure all four together to enable admin WhatsApp notifications.
# Use the API/backend origin; do not use the frontend URL.
WHATSAPP_NOTIFY_PHONE=
CALLMEBOT_API_KEY=
WHATSAPP_ACTION_BASE_URL=
# Independent random secret, at least 32 characters; never reuse JWT_SECRET.
WHATSAPP_ACTION_SECRET=
